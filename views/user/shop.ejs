<style>





/* home */



#colorlib-logo{

font-size:30px;

font-weight:700;

letter-spacing:3px;
   

}

.main-nav{

display:flex;

align-items:center;



gap:30px;

margin:0;

padding:0;

list-style:none;


justify-content: space-between;
  

}


.main-nav li{

list-style:none;

}

.main-nav a{

text-decoration:none;

font-size:15px;

font-weight:600;

color:#222;

transition:.3s;

}

.main-nav a:hover{

color:#339999;

}

.nav-icons a{

font-size:20px;

}



/* product */


.product-entry{
    background:#fff;
    border:none !important;
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 8px 25px rgba(0,0,0,.08);
    transition:all .35s ease;
    position:relative;
    margin-bottom:30px;
}

.product-entry:hover{
    transform:translateY(-8px);
    box-shadow:0 20px 45px rgba(0,0,0,.15);
}


.prod-img{
    display:block;
    overflow:hidden;
    background:#f8f9fa;
}

.prod-img img{
    width:100%;
    height:280px;
    object-fit:cover;
}

.product-entry:hover .prod-img img{
    transform:scale(1.08);
}

.desc{
    padding:20px;
    text-align:left !important;
}

.desc h6{
    margin-top:10px;
    margin-bottom:8px;
}

.desc h6 a{
    color:#222;
    font-size:18px;
    font-weight:600;
    text-decoration:none;
}

.desc h6 a:hover{
    color:#339999;
}

.price{
    font-size:22px;
    color:#339999;
    font-weight:700;
}


.desc{
    padding:20px;
}

.desc h6{
    margin-top:12px;
    margin-bottom:10px;
    line-height:1.4;
}
.wishlist-btn{
    position:absolute;
    top:15px;
    right:15px;
    z-index:5;
}

.wishlist-btn a{
    width:42px;
    height:42px;
    background:#fff;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#339999;
    text-decoration:none;
    box-shadow:0 5px 15px rgba(0,0,0,.15);
    transition:.3s;
}

.wishlist-btn a:hover{
    background:#339999;
    color:#fff;
}


.view-btn{
    display:block;
    width:100%;
    text-align:center;
    margin-top:20px;
    padding:14px;
    background:#339999;
    color:#fff;
    border-radius:10px;
    text-decoration:none;
    font-weight:600;
    transition:.3s;
}

.view-btn:hover{
    background:#267373;
    color:#fff;
}



/* ==========================
   SHOP HERO
========================== */


.movino-shop-hero{
    width:100vw;
    margin-left:calc(50% - 50vw);
