        </option>

        <option value="z-a"
            <%= sort === 'z-a' ? 'selected' : '' %>>
            Name : Z-A
        </option>

    </select>

    <input type="hidden"
           name="query"
           value="<%= query || '' %>">

    <input type="hidden"
           name="category"
           value="<%= selectedCategory || '' %>">

    <input type="hidden"
           name="subCategory"
           value="<%= selectedSubCategory || '' %>">

    <input type="hidden"
           name="priceMin"
           value="<%= priceMin || '' %>">

    <input type="hidden"
           name="priceMax"
           value="<%= priceMax || '' %>">

</form>


