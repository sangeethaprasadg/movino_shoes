    margin:0;
}


/*==========================
FILTER CARD
==========================*/

.filter-card{

background:#fff;

padding:35px;

border-radius:24px;

box-shadow:0 20px 45px rgba(0,0,0,.08);

}

.filter-header{

display:flex;

justify-content:space-between;

align-items:flex-start;

margin-bottom:30px;

}

.filter-header h4{

font-size:28px;

font-weight:700;

margin:0;

}

.filter-header p{

margin-top:6px;

font-size:13px;

color:#999;

}

.filter-header a{

text-decoration:none;

font-weight:600;

color:#339999;

}

.form-select{

height:58px;

background:#fafafa;

border:1px solid #e6e6e6;

border-radius:16px;

padding-left:18px;

font-size:15px;

font-weight:500;

transition:.3s;

}

.form-select:hover{

border-color:#339999;

}

.form-select:focus{

background:white;

border-color:#339999;

box-shadow:0 0 0 5px rgba(51,153,153,.15);

}

.form-control{

height:58px;

background:#fafafa;

border:1px solid #e6e6e6;

border-radius:16px;

padding-left:18px;

transition:.3s;

}

.form-control:focus{

background:white;

border-color:#339999;

box-shadow:0 0 0 5px rgba(51,153,153,.15);

}

.apply-filter-btn{

width:100%;

height:58px;

border:none;

border-radius:16px;

background:linear-gradient(135deg,#339999,#267373);

color:white;

font-size:16px;

font-weight:700;

transition:.3s;

cursor:pointer;

}

.apply-filter-btn:hover{

transform:translateY(-3px);

box-shadow:0 15px 30px rgba(51,153,153,.35);

}
.filter-title{

display:block;

font-size:15px;

font-weight:700;

margin-bottom:10px;

color:#333;

}

/*==========================
PRODUCT TOOLBAR
==========================*/

.product-toolbar{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:35px;

padding-bottom:20px;

border-bottom:1px solid #ececec;

}

.shop-title{

font-size:34px;

font-weight:700;

margin-bottom:5px;

}

.shop-count{

font-size:15px;

color:#777;

margin:0;

}

.sort-select{

width:220px;

height:50px;

border-radius:15px;

padding:0 18px;

border:1px solid #e5e7eb;

background:#fafafa;

font-size:15px;

font-weight:500;

transition:.3s;

}

.sort-select:hover{

border-color:#339999;

}

.sort-select:focus{

border-color:#339999;

box-shadow:0 0 0 4px rgba(51,153,153,.15);

}

.colorlib-product{
