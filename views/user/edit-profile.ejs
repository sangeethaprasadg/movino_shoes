<script>

    // update name
    
    document.getElementById('updateNameBtn').addEventListener('click', async (e) => {
        e.preventDefault();
  
const name = document.getElementById('name').value.trim();

const regex = /^[A-Za-z ]+$/;

if (!name) {
    return Swal.fire("Error", "Name is required", "error");
}

if (name.length < 3 || name.length > 30) {
    return Swal.fire("Error", "Name must be between 3 and 30 characters", "error");
}

if (!regex.test(name)) {
    return Swal.fire("Error", "Only letters and spaces are allowed", "error");
}

    
        const response = await fetch('/update-name', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name })
        });
        const data = await response.json();
    
        if (data.success) {
            Swal.fire('Success', 'Name updated successfully!', 'success');
            document.querySelector('.dropdown-link strong').innerText = data.updatedName;
        } else {
            Swal.fire('Error', 'Failed to update name. Try again.', 'error');
        }
    });
    
    
    // Open Email Modal
    
    function openEmailModal() {
        document.getElementById('emailModal').style.display = 'block';
    }
    
    function closeEmailModal() {
        document.getElementById('emailModal').style.display = 'none';
        document.getElementById('otpSection').style.display = 'none';
    }
    
    async function sendOTP() {
        const email = document.getElementById('newEmail').value;
        if (!email) return Swal.fire('Error', 'Enter a valid email.', 'error');
    
        const response = await fetch('/send-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
        });
    
        const data = await response.json();
    
        if (data.success) {
            Swal.fire('Success', 'OTP sent!', 'success');
            document.getElementById('otpSection').style.display = 'block';
             startTimer();
        } else {
            Swal.fire('Error', data.message || 'Failed to send OTP', 'error');
        }
    }
    
  async function verifyOTP() {

    const email = document.getElementById('newEmail').value.trim();
    const otp = document.getElementById('otpInput').value.trim();

    if (!otp) {
        return Swal.fire(
            'Error',
            'Please enter the OTP.',
            'error'
        );
    }

    const response = await fetch('/verify-email-otp', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            email,
            otp
        })
    });

    const data = await response.json();

    if (data.success) {

        Swal.fire(
            'Success',
            'Email updated successfully!',
            'success'
        );

        document.getElementById("userEmail").innerText =
            data.updatedEmail;

        closeEmailModal();

    } else {

        Swal.fire(
            'Invalid OTP',
            data.message || 'The OTP you entered is incorrect.',
            'error'
        );

    }
}
    
    
    
    
    let timerInterval;

function startTimer() {
    let timeLeft = 60;

    const timer = document.getElementById("timer");

    clearInterval(timerInterval);

    timer.innerText = timeLeft;

    timerInterval = setInterval(() => {
        timeLeft--;

        timer.innerText = timeLeft;

        if (timeLeft <= 0) {
            clearInterval(timerInterval);
            timer.innerText = "Expired";
        }

    }, 1000);
}
    
    
        // password
    
    
       
    document.addEventListener("DOMContentLoaded", function () {
        const currentPass = document.getElementById("currentPassword");
        const newPass = document.getElementById("newPassword");
        const confirmPass = document.getElementById("confirmNewPassword");
    
        const errorCurrent = document.getElementById("errorCurrent");
        const errorNew = document.getElementById("errorNew");
        const errorConfirm = document.getElementById("errorConfirm");
    
        const form = document.getElementById("changePasswordForm");
    
        function validateCurrentPassword() {
            if (currentPass.value.trim() === "") {
                errorCurrent.style.display = "block";
                errorCurrent.innerHTML = "Please enter your current password";
            } else {
                errorCurrent.style.display = "none";
                errorCurrent.innerHTML = "";
            }
        }
    
        function validateNewPassword() {
            const passVal = newPass.value.trim();
            const alpha = /[a-zA-Z]/;
            const digit = /\d/;
    
            if (passVal.length < 8) {
                errorNew.style.display = "block";
                errorNew.innerHTML = "Should contain at least 8 characters";
            } else if (!alpha.test(passVal) || !digit.test(passVal)) {
                errorNew.style.display = "block";
                errorNew.innerHTML = "Should contain numbers and alphabets";
            } else {
                errorNew.style.display = "none";
                errorNew.innerHTML = "";
            }
    
            // Also check confirm field if already typed
            if (confirmPass.value.trim() !== "") {
                validateConfirmPassword();
            }
        }
    
        function validateConfirmPassword() {
            if (newPass.value.trim() !== confirmPass.value.trim()) {
                errorConfirm.style.display = "block";
                errorConfirm.innerHTML = "Passwords do not match";
            } else {
                errorConfirm.style.display = "none";
                errorConfirm.innerHTML = "";
            }
        }
    
        // Real-time validation
        currentPass.addEventListener("input", validateCurrentPassword);
        newPass.addEventListener("input", validateNewPassword);
        confirmPass.addEventListener("input", validateConfirmPassword);
    
        // Final check on submit
       form.addEventListener("submit", async function (e) {
    e.preventDefault();

    validateCurrentPassword();
    validateNewPassword();
    validateConfirmPassword();

    if (errorCurrent.innerHTML || errorNew.innerHTML || errorConfirm.innerHTML) {
        return;
    }
const response = await fetch("/change-password", {
    method: "POST",
    headers: {
        "Content-Type": "application/json"
    },
    body: JSON.stringify({
        currentPassword: currentPass.value,
        newPassword: newPass.value
    })
});

const data = await response.json();

if (data.success) {

    Swal.fire({
        icon: "success",
        title: "Success",
        text: data.message
    });

    form.reset();

} else {

    Swal.fire({
        icon: "error",
        title: "Error",
        text: data.message
    });

}
  
});
    });
    
    
    
    
    
    
    
    
    
        
      
    </script>









