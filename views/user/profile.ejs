<style>
    .list-group-item.active {
        background-color: #339999 !important;
        color: white !important;
        border-color: #339999 !important;
    }
    
    .card-body img {
        margin-bottom: 15px;
    }
    
    .btn-sm {
        margin-right: 10px;
    }



.profile-image{
    width:120px;
    height:120px;
    border-radius:50%;
    object-fit:cover;
    border:4px solid #fff;
    box-shadow:0 8px 20px rgba(0,0,0,.15);
}

.profile-image-actions{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:12px;
    margin-top:15px;
}

.profile-image-actions form{
    margin:0;
}

.edit-photo-btn,
.delete-photo-btn{
    width:46px;
    height:46px;
    border-radius:50%;
    border:1px solid #ddd;
    background:#fff;
    display:flex;
    justify-content:center;
    align-items:center;
    cursor:pointer;
    transition:.3s;
}

.edit-photo-btn{
    color:#0d6efd;
}

.delete-photo-btn{
    color:#dc3545;
}

.edit-photo-btn:hover,
.delete-photo-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 8px 18px rgba(0,0,0,.15);
}



</style>
