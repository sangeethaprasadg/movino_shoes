  <!-- Address Validation Script -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      
      function setupAddressValidation(formId, prefix) {
        const form = document.getElementById(formId);
        const name = document.getElementById(prefix + "-fullName");
        const phone = document.getElementById(prefix + "-phone");
        const pincode = document.getElementById(prefix + "-pincode");
        const state = document.getElementById(prefix + "-state");
        const city = document.getElementById(prefix + "-city");
        const addressLine = document.getElementById(prefix + "-addressLine");
    
        const error1 = document.getElementById(prefix + "-error1");
        const error2 = document.getElementById(prefix + "-error2");
        const error3 = document.getElementById(prefix + "-error3");
        const error4 = document.getElementById(prefix + "-error4");
        const error5 = document.getElementById(prefix + "-error5");
        const error6 = document.getElementById(prefix + "-error6");
    
        function validateName() {
          const pattern = /^[A-Za-z\s]+$/;
          if (name.value.trim() === "") {
            error1.innerHTML = "Please enter a valid name";
          } else if (!pattern.test(name.value)) {
            error1.innerHTML = "Name can only contain alphabets and spaces";
          } else {
            error1.innerHTML = "";
          }
        }
    
        function validatePhone() {
          const pattern = /^[0-9]{10}$/;
          if (!pattern.test(phone.value)) {
            error2.innerHTML = "Enter a valid 10-digit mobile number";
          } else {
            error2.innerHTML = "";
          }
        }
    
        function validatePincode() {
          const pattern = /^[0-9]{6}$/;
          if (!pattern.test(pincode.value)) {
            error3.innerHTML = "Enter a valid 6-digit pincode";
          } else {
            error3.innerHTML = "";
          }
        }
    
        function validateState() {
  const pattern = /^[A-Za-z\s]+$/; // Only alphabets and spaces
  if (state.value.trim() === "") {
    error4.innerHTML = "State is required";
  } else if (!pattern.test(state.value)) {
    error4.innerHTML = "State can only contain alphabets";
  } else {
    error4.innerHTML = "";
  }
}

function validateCity() {
  const pattern = /^[A-Za-z\s]+$/; // Only alphabets and spaces
  if (city.value.trim() === "") {
    error5.innerHTML = "City is required";
  } else if (!pattern.test(city.value)) {
    error5.innerHTML = "City can only contain alphabets";
  } else {
    error5.innerHTML = "";
  }
}

    
        function validateAddress() {
          if (addressLine.value.trim().length < 5) {
            error6.innerHTML = "Please enter at least 5 characters";
          } else {
            error6.innerHTML = "";
          }
        }
    
        name.addEventListener("input", validateName);
        phone.addEventListener("input", validatePhone);
        pincode.addEventListener("input", validatePincode);
        state.addEventListener("input", validateState);
        city.addEventListener("input", validateCity);
        addressLine.addEventListener("input", validateAddress);
    
        form.addEventListener("submit", function (e) {
          validateName();
          validatePhone();
          validatePincode();
          validateState();
          validateCity();
          validateAddress();
    
          if (error1.innerHTML || error2.innerHTML || error3.innerHTML || error4.innerHTML || error5.innerHTML || error6.innerHTML) {
            e.preventDefault();
          }
        });
      }
    
      // For Add Address
      setupAddressValidation("addAddressForm", "add");
    
      // For Edit Address (multiple possible, so select all)
      document.querySelectorAll("[id^='editAddressForm-']").forEach(form => {
        const idSuffix = form.id.replace("editAddressForm-", "");
        setupAddressValidation(form.id, "edit");
      });
    });
    </script>
    

