		<div class="colorlib-product">
    <div class="container">

        <div class="row row-pb-lg product-detail-wrap">

            <!-- ================= PRODUCT IMAGE ================= -->
            <div class="col-md-6">

                <div class="product-gallery">

                    <!-- Main Image -->
                    <div class="main-image-container zoom-container">

                        <img
                            id="mainProductImage"
                            src="/uploads/products/<%= product.images[0] %>"
                            class="main-product-image zoom-image"
                            alt="<%= product.name %>"
                        >

                    </div>

                    <!-- Thumbnails -->
                    <div class="product-thumbnails">

                        <% product.images.forEach(function(image, index) { %>

                            <div
                                class="thumbnail <%= index === 0 ? 'active' : '' %>"
                                onclick="changeProductImage('<%= image %>', this)"
                            >

                                <img
                                    src="/uploads/products/<%= image %>"
                                    alt="<%= product.name %>"
                                >

                            </div>

                        <% }) %>

                    </div>

                </div>

            </div>


            <!-- ================= PRODUCT DETAILS ================= -->
            <div class="col-md-6">

                <div class="product-desc">

                    <h3>
                        <%= product.name %>
                    </h3>

                    <p class="price">
                        <strong>₹<%= product.price %></strong>
                    </p>

                    <p class="product-rating">
                        <span class="rate">
                            <i class="icon-star-full"></i>
                            <i class="icon-star-full"></i>
                            <i class="icon-star-full"></i>
                            <i class="icon-star-full"></i>
                            <i class="icon-star-half"></i>
                            <span>(74 Ratings)</span>
                        </span>
                    </p>

                    <p class="product-description">
                        <%= product.description %>
                    </p>


                    <!-- ================= SIZE ================= -->

                    <h5 class="mt-4 mb-3">Select Size</h5>

                    <form
                        action="/cart/add/<%= product._id %>?from=product"
                        method="POST"
                    >

                        <div class="size-container">

                            <% if (product.variants && product.variants.length > 0) { %>

                                <% product.variants.forEach(function(variant){ %>

                                    <input
                                        type="radio"
                                        id="size-<%= variant.size %>"
                                        name="size"
                                        value="<%= variant.size %>"
                                        data-stock="<%= variant.stock %>"
                                        hidden
                                        required
                                        <%= variant.stock === 0 ? "disabled" : "" %>
                                    >

                                    <label
                                        for="size-<%= variant.size %>"
                                        class="size-btn <%= variant.stock === 0 ? 'disabled-size' : '' %>"
                                    >
                                        <%= variant.size %>
                                    </label>

                                <% }) %>

                            <% } else { %>

                                <p>No sizes available</p>

                            <% } %>

                        </div>


                        <p id="stockMessage" class="stock-message"></p>


                        <!-- ================= QUANTITY ================= -->

                        <% if (product.stock > 0) { %>

                            <div class="quantity-wrapper">

                                <button
                                    type="button"
                                    class="quantity-left-minus btn"
                                >
                                    <i class="icon-minus2"></i>
                                </button>

                                <input
                                    type="text"
                                    id="quantity"
                                    name="quantity"
                                    class="form-control input-number"
                                    value="1"
                                    min="1"
                                    max="100"
                                >

                                <button
                                    type="button"
                                    class="quantity-right-plus btn"
                                >
                                    <i class="icon-plus2"></i>
                                </button>

                            </div>

                        <% } %>


                        <!-- ================= AVAILABILITY ================= -->

                        <% if (product.isBlocked || product.category?.isBlocked) { %>

                            <p class="product-unavailable">
                                This product is currently unavailable.
                            </p>

                        <% } %>


                        <!-- ================= ADD TO CART ================= -->

                        <button
                            type="submit"
                            class="btn btn-primary add-cart-btn"
                            <% if (
                                product.isBlocked ||
                                product.category?.isBlocked ||
                                product.stock <= 0
                            ) { %>
                                disabled
                            <% } %>
                        >

                            <% if (product.stock <= 0) { %>

                                Out of Stock

                            <% } else { %>

                                Add to Cart

                            <% } %>

                        </button>

                    </form>


                    <% if (error === 'outofstock') { %>

                        <div class="alert alert-danger mt-3">
                            Sorry, this product is currently
                            <strong>Out of Stock</strong>.
                        </div>

                    <% } %>


                    <% if (error === 'maxlimit') { %>

                        <script>
                            Swal.fire({
                                icon: "warning",
                                title: "Purchase Limit Reached",
                                text: "Maximum 5 units are allowed per product.",
                                confirmButtonText: "OK"
                            });
                        </script>

                    <% } %>

                </div>

            </div>

        </div>


				
				






