<style>
.size-container{
    display:flex;
    gap:10px;
    margin-bottom:20px;
}

.size-btn{
    width:45px;
    height:45px;
    border:1px solid #333;
    border-radius:5px;
    display:flex;
    justify-content:center;
    align-items:center;
    cursor:pointer;
    transition:.2s;
    font-weight:600;
}

.size-btn:hover{
    background:#f5f5f5;
}

input[type="radio"]:checked + .size-btn{
    background:#000;
    color:#fff;
    border-color:#000;
}

.disabled-size {
    background: #e9ecef;
    color: #999;
    border-color: #ccc;
    cursor: not-allowed;
    opacity: 0.6;
}



.zoom-container{
    overflow: hidden;
    cursor: zoom-in;
    position: relative;
}

.zoom-image{
    width:100%;
    transition: transform .15s ease;
    transform-origin:center center;
}


/* =========================
   PRODUCT IMAGE GALLERY
========================= */

.product-gallery {
    width: 100%;
}

.main-image-container {
    width: 100%;
    height: 400px;
    overflow: hidden;
    border-radius: 12px;
    background: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: zoom-in;
}

.main-product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform .2s ease;
}


/* Thumbnails */

.product-thumbnails {
    display: flex;
    gap: 12px;
    margin-top: 15px;
    overflow-x: auto;
}

.thumbnail {
    width: 85px;
    height: 85px;
    flex-shrink: 0;
    border: 2px solid transparent;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    background: #f8f8f8;
    transition: .25s ease;
}

.thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.thumbnail:hover {
    border-color: #339999;
}

.thumbnail.active {
    border-color: #339999;
}



/* =========================
   PRODUCT DETAIL LAYOUT
========================= */

.product-detail-wrap {
    align-items: flex-start;
}

.product-gallery {
    padding-right: 25px;
}

.main-image-container {
    width: 100%;
    height: 520px;
    overflow: hidden;
    border-radius: 14px;
    background: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: zoom-in;
}

.main-product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.2s ease;
}


/* =========================
   THUMBNAILS
========================= */

.product-thumbnails {
    display: flex;
    gap: 12px;
    margin-top: 15px;
}

.thumbnail {
    width: 80px;
    height: 80px;
    border: 2px solid transparent;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    background: #f8f8f8;
    transition: all 0.25s ease;
}

.thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.thumbnail:hover,
.thumbnail.active {
    border-color: #339999;
}


/* =========================
   PRODUCT DETAILS
========================= */

.product-desc {
    padding: 15px 20px;
}

.product-desc h3 {
    font-size: 30px;
    margin-bottom: 15px;
}

.product-desc .price strong {
    font-size: 25px;
}

.product-rating {
    margin: 15px 0;
}

.product-description {
    line-height: 1.8;
    color: #666;
}


/* =========================
   QUANTITY
========================= */

.quantity-wrapper {
    display: flex;
    align-items: center;
    width: 150px;
    margin: 20px 0;
}

.quantity-wrapper button {
    width: 40px;
    height: 42px;
    border: 1px solid #ddd;
    background: #f8f8f8;
}

.quantity-wrapper input {
    width: 60px;
    height: 42px;
    text-align: center;
    border: 1px solid #ddd;
}


/* =========================
   ADD TO CART
========================= */

