    border-radius: 4px;
    margin-top: 10px;
}

.stock-message {
    min-height: 22px;
    font-weight: 600;
}

.product-unavailable {
    color: #dc3545;
    font-weight: 600;
    margin-top: 15px;
}


/* =========================
   PRODUCT DETAILS POLISH
