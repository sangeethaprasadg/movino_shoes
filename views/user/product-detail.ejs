	<script>














const quantityInput = document.getElementById("quantity");
const minusButton = document.querySelector(".quantity-left-minus");
const plusButton = document.querySelector(".quantity-right-plus");

const sizeRadios = document.querySelectorAll('input[name="size"]');
const stockMessage = document.getElementById("stockMessage");

// Maximum 5 units per product
const purchaseLimit = 5;

// Current selected size stock
let selectedStock = 5;


// =========================
// UPDATE BUTTONS
// =========================

function updateQuantityButtons() {

    if (!quantityInput) return;

    let quantity = parseInt(quantityInput.value) || 1;

    // Never allow quantity below 1
    if (quantity < 1) {
        quantity = 1;
        quantityInput.value = 1;
    }

    // Maximum allowed = minimum of stock and purchase limit
    const maxAllowed = Math.min(selectedStock, purchaseLimit);

    // Minus disabled at 1
    if (minusButton) {
        minusButton.disabled = quantity <= 1;
    }

   
	    // Only disable plus when product is completely out of stock
   if (plusButton) {
    plusButton.disabled = selectedStock === 0;
}
}


// =========================
// SIZE SELECTION
// =========================

sizeRadios.forEach((radio) => {

    radio.addEventListener("change", function () {

        selectedStock = Number(this.dataset.stock) || 0;

        // Reset quantity whenever size changes
        quantityInput.value = 1;

        // Stock message
        if (selectedStock === 0) {

            stockMessage.innerHTML =
                '<span style="color:red;">Out of Stock</span>';

        } else if (selectedStock <= 3) {

            stockMessage.innerHTML =
                '<span style="color:orange;">Limited stock</span>';

        } else {

            stockMessage.innerHTML = "";

        }

        updateQuantityButtons();

    });

});


// =========================
// MINUS BUTTON
// =========================

if (minusButton) {

    minusButton.addEventListener("click", function (e) {

        e.preventDefault();

        let quantity = parseInt(quantityInput.value) || 1;

        // NEVER allow 0
        if (quantity > 1) {

            quantity--;

            quantityInput.value = quantity;

        }

        updateQuantityButtons();

    });

}


// =========================
// PLUS BUTTON
// =========================

if (plusButton) {

    plusButton.addEventListener("click", function (e) {

        e.preventDefault();

        let quantity = parseInt(quantityInput.value) || 1;

        const maxAllowed = Math.min(
            selectedStock,
            purchaseLimit
        );


        // Already reached maximum
        if (quantity >= maxAllowed) {

            Swal.fire({
                icon: "warning",
                title: "Maximum Purchase Limit",
                text: `You can purchase maximum ${purchaseLimit} units of this product.`,
                confirmButtonText: "OK"
            });

            return;
        }


        // Increase quantity
        quantity++;

        quantityInput.value = quantity;

        updateQuantityButtons();

    });

}


// =========================
// MANUAL QUANTITY INPUT
// =========================

if (quantityInput) {

    quantityInput.addEventListener("input", function () {

        let quantity = parseInt(this.value);

        const maxAllowed = Math.min(
            selectedStock,
            purchaseLimit
        );


        // Empty / invalid / below 1
        if (isNaN(quantity) || quantity < 1) {

            this.value = 1;

            updateQuantityButtons();

            return;
        }


        // User entered more than allowed
        if (quantity > maxAllowed) {

            this.value = maxAllowed;

            Swal.fire({
                icon: "warning",
                title: "Maximum Purchase Limit",
                text: `You can purchase maximum ${purchaseLimit} units of this product.`,
                confirmButtonText: "OK"
            });

        }

        updateQuantityButtons();

    });

}


// =========================
// INITIAL STATE
// =========================

if (quantityInput) {

    quantityInput.value = 1;

    updateQuantityButtons();

}








function changeProductImage(image, thumbnail) {

    const mainImage = document.getElementById("mainProductImage");

    mainImage.src = "/uploads/products/" + image;

    document.querySelectorAll(".thumbnail").forEach(item => {
        item.classList.remove("active");
    });

    thumbnail.classList.add("active");

}



document.querySelectorAll(".zoom-container").forEach(container => {

    const image = container.querySelector(".zoom-image");

    if (!image) return;

    container.addEventListener("mousemove", (e) => {

        const rect = container.getBoundingClientRect();

        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;

        image.style.transformOrigin = `${x}% ${y}%`;
        image.style.transform = "scale(1.8)";

    });

    container.addEventListener("mouseleave", () => {

        image.style.transformOrigin = "center center";
        image.style.transform = "scale(1)";

    });

});


const urlParams = new URLSearchParams(window.location.search);
const error = urlParams.get('error');

if (error === 'unavailable') {

    Swal.fire({
        icon: 'error',
        title: 'Product Unavailable',
        text: 'This product is currently unavailable.',
        confirmButtonColor: '#339999',
        confirmButtonText: 'OK'
    });

}

if (error === 'outofstock') {

    Swal.fire({
        icon: 'warning',
        title: 'Out of Stock',
        text: 'This product is currently out of stock.',
        confirmButtonColor: '#339999',
        confirmButtonText: 'OK'
    });

}

// Remove error from URL
if (error) {
    window.history.replaceState(
        {},
        document.title,
        window.location.pathname
    );
}



	</script>




