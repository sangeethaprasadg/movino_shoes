						<script>
						
	async function updateCartQuantity(productId,size, change) {
   const row = document.querySelector(
    `[data-product-id="${productId}"][data-size="${size}"]`
);
    const quantityInput = row.querySelector('.quantity-input');
    const itemTotalElement = row.querySelector('.item-total');
    const cartTotalElement = document.querySelector('#cart-total-amount');

    try {
        const response = await fetch(`/cart/update-quantity/${productId}`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ change ,size })
        });

        if (!response.ok) {
            const msg = await response.text();

            // ✅ Show SweetAlert for out of stock
           if (msg === "Exceeds stock availability.") {

    Swal.fire({
        icon: "warning",
        title: "Out of Stock",
        text: "You cannot add more items than available stock!",
    });

} else if (msg === "Maximum 5 units allowed per product.") {

    Swal.fire({
        icon: "warning",
        title: "Limit Reached",
        text: "You can purchase a maximum of 5 units of this product.",
    });

} else {

    alert(msg);

}

            return;
        }

        const data = await response.json();

        if (data.newQuantity <= 0) {
            row.remove();
        } else {
            quantityInput.value = data.newQuantity;
            itemTotalElement.innerText = `₹${data.newTotalPrice.toFixed(2)}`;
        }

        cartTotalElement.innerText = `₹${data.cartTotal.toFixed(2)}`;

    } catch (err) {
        console.error(err);
        alert("Something went wrong. Please try again.");
    }
}




		// remove 					
     async function removeCartItem(productId,size) {


    const row = document.querySelector(`[data-product-id="${productId}"]`);
    const cartTotalElement = document.querySelector('#cart-total-amount');

    try {
      const response = await fetch(`/cart/remove/${productId}`, {

		
        method: "POST",
		headers: {
    "Content-Type": "application/json"
},
body: JSON.stringify({ size })
      });

      if (!response.ok) {
        const msg = await response.text();
        alert(msg);
        return;
      }

      const data = await response.json(); // Make sure your backend sends JSON response with updated total
      row.remove(); // Remove the item row from the DOM
      cartTotalElement.innerText = `₹${data.cartTotal.toFixed(2)}`;

    } catch (err) {
      console.error(err);
      alert("Error removing item. Please try again.");
    }
  }


</script>
						


