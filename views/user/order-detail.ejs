               <div class="container order-details-wrapper">

    <!-- Page Heading -->

    <h2 class="order-page-title">
        Order Details
    </h2>

    <p class="order-page-subtitle">
        View your order information and track your items
    </p>


    <!-- Order Information -->

    <div class="order-info-card">

        <div class="order-info-row">

            <div class="order-info-item">

                <span class="order-info-label">
                    Order ID
                </span>

                <span class="order-info-value">
                    <%= order.orderId %>
                </span>

            </div>


            <div class="order-info-item">

                <span class="order-info-label">
                    Payment Method
                </span>

                <span class="order-info-value">
                    <%= order.paymentMethod %>
                </span>

            </div>


            <div class="order-info-item">

                <span class="order-info-label">
                    Order Date
                </span>

                <span class="order-info-value">
                    <%= order.createdAt.toDateString() %>
                </span>

            </div>

        </div>

    </div>



    <!-- Products -->

    <div class="order-products-card">

        <div class="order-products-header">

            <h4>
                Ordered Items
            </h4>

        </div>


        <div style="overflow-x:auto;">

            <table class="order-table">

                <thead>

                    <tr>

                        <th>Product</th>

                        <th>Qty</th>

                        <th>Price</th>

                        <th>Total</th>

                        <th>Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody>

                    <% order.orderItems.forEach(item => { %>

                    <tr>

                        <!-- Product -->

                        <td>

                            <span class="product-name">
                                <%= item.product.name %>
                            </span>

                        </td>


                        <!-- Quantity -->

                        <td>
                            <%= item.quantity %>
                        </td>


                        <!-- Price -->

                        <td>
                            ₹<%= item.price %>
                        </td>


                        <!-- Total -->

                        <td>

                            <strong>
                                ₹<%= item.totalPrice %>
                            </strong>

                        </td>


                        <!-- Status -->

                        <td>

                            <%
                            let statusClass = '';

                            if(item.status === 'Delivered') {
                                statusClass = 'delivered';
                            }
                            else if(item.status === 'Cancelled') {
                                statusClass = 'cancelled';
                            }
                            else if(item.status === 'Returned') {
                                statusClass = 'returned';
                            }
                            else if(item.status === 'Refunded') {
                                statusClass = 'refunded';
                            }
                            %>

                            <span class="order-status <%= statusClass %>">

                                <%= item.status %>

                            </span>

                        </td>


                        <!-- Actions -->

                        <td>

                            <% if (item.status === 'Pending' || item.status === 'Processing') { %>

                                <form
                                    action="/cancel-item/<%= order._id %>/<%= item._id %>"
                                    method="POST"
                                    style="display:flex; align-items:center;">

                                    <input
                                        type="text"
                                        name="reason"
                                        class="reason-input"
                                        placeholder="Reason (optional)"
                                    />

                                    <button
                                        type="submit"
                                        class="movino-btn cancel-btn">

                                        Cancel

                                    </button>

                                </form>


                            <% } else if (item.status === 'Delivered') { %>

                                <form
                                    action="/return-order/<%= order.orderId %>/<%= item._id %>"
                                    method="POST"
                                    style="display:flex; align-items:center;">

                                    <input
                                        type="text"
                                        name="reason"
                                        class="reason-input"
                                        placeholder="Reason for return"
                                        required
                                    />

                                    <button
                                        type="submit"
                                        class="movino-btn">

                                        Return

                                    </button>

                                </form>


                            <% } else { %>

                                <span style="color:#aaa; font-size:13px;">
                                    No action available
                                </span>

                            <% } %>

                        </td>

                    </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

    </div>



    <!-- Bottom Buttons -->

    <div class="order-bottom-actions">

        <a
            href="/my-orders"
            class="movino-btn back-btn">

            ← Back to Orders

        </a>


        <a
            href="/invoice/<%= order.orderId %>"
            target="_blank"
            class="movino-btn invoice-btn">

            Download Invoice

        </a>

    </div>

</div>



