<script>
	

	const urlParams = new URLSearchParams(window.location.search);
     const cancelled = urlParams.get('cancelled') === 'true';
	 const returnSuccess = urlParams.get('returnSuccess') === 'true';
	  if (cancelled) {
		Swal.fire({
		  icon: 'success',
		  title: 'Cancelled!',
		  text: 'Order item cancelled successfully',
		  confirmButtonColor: '#3085d6'
		});
	  }

	    // Optional: remove the query param from the URL after showing the alert
		if (window.history.replaceState) {
			const cleanUrl = window.location.href.split('?')[0];
			window.history.replaceState(null, null, cleanUrl);
		  }


		  if (returnSuccess) {
    Swal.fire({
      icon: 'success',
      title: 'Return Request Submitted',
      text: 'Your return request was submitted successfully.',
    });

	 // Remove query param from URL so alert doesn't show on refresh
	 if (window.history.replaceState) {
      const cleanUrl = window.location.href.split('?')[0];
      window.history.replaceState(null, null, cleanUrl);
    }

		  }

	</script>

<script>
	// Force full reload when user navigates back
	window.addEventListener('pageshow', function (event) {
	  if (event.persisted) {
		window.location.reload();
	  }
	});
