/* ================================
   MOVINO ORDER DETAILS
================================ */

.colorlib-product {
    padding-top: 0 !important;
}

.order-details-wrapper {
    margin-top: 5px !important;
    margin-bottom: 50px;
}

.order-page-title {
    font-size: 32px;
    font-weight: 600;
    color: #222;
    margin-bottom: 8px;
}

.order-page-subtitle {
    color: #888;
    font-size: 14px;
    margin-bottom: 30px;
}


/* Order information card */

.order-info-card {
    background: #fff;
    border: 1px solid #eeeeee;
    border-radius: 10px;
    padding: 25px 30px;
    margin-bottom: 30px;
    box-shadow: 0 4px 18px rgba(0,0,0,0.05);
}

.order-info-row {
    display: flex;
    flex-wrap: wrap;
    gap: 45px;
}

.order-info-item {
    min-width: 180px;
}

.order-info-label {
    display: block;
    color: #999;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    margin-bottom: 6px;
}

.order-info-value {
    font-size: 15px;
    font-weight: 500;
    color: #333;
}


/* Products card */

.order-products-card {
    background: #fff;
    border: 1px solid #eeeeee;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(0,0,0,0.05);
}

.order-products-header {
    padding: 22px 25px;
    border-bottom: 1px solid #eeeeee;
}

.order-products-header h4 {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    color: #333;
}


/* Table */

.order-table {
    width: 100%;
    border-collapse: collapse;
}

.order-table thead {
    background: #f7f9f9;
}

.order-table th {
    padding: 16px 20px;
    color: #777;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid #eeeeee;
}

.order-table td {
    padding: 20px;
    border-bottom: 1px solid #eeeeee;
    color: #555;
    font-size: 14px;
    vertical-align: middle;
}

.order-table tbody tr:last-child td {
    border-bottom: none;
}

.order-table tbody tr:hover {
    background: #fafcfc;
}


/* Product */

.product-name {
    font-weight: 500;
    color: #333;
}


/* Status */

.order-status {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    background: #fff5d9;
    color: #d97706;
}

.order-status.delivered {
    background: #e8f8ed;
    color: #16a34a;
}

.order-status.cancelled {
    background: #fdecec;
    color: #dc2626;
}

.order-status.returned {
    background: #ede9fe;
    color: #7c3aed;
}

.order-status.refunded {
    background: #e0f2fe;
    color: #0284c7;
}


/* Reason input */

.reason-input {
    height: 38px;
    border: 1px solid #dddddd;
    border-radius: 5px;
    padding: 8px 12px;
    font-size: 13px;
    outline: none;
    margin-right: 6px;
    width: 160px;
}

.reason-input:focus {
    border-color: #339999;
    box-shadow: 0 0 0 2px rgba(51,153,153,0.08);
}


/* MOVINO buttons */

.movino-btn {
    display: inline-block;
    border: none;
    background: #339999;
    color: #fff !important;
    padding: 9px 17px;
    border-radius: 5px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none !important;
    transition: all 0.25s ease;
}

.movino-btn:hover {
    background: #2d8787;
    color: #fff !important;
    transform: translateY(-1px);
}


/* Cancel */

.cancel-btn {
    background: #fff;
    color: #dc3545 !important;
    border: 1px solid #dc3545;
}

.cancel-btn:hover {
    background: #dc3545;
    color: #fff !important;
}


/* Bottom actions */

.order-bottom-actions {
    margin-top: 30px;
    display: flex;
    gap: 10px;
}

.back-btn {
    background: #fff;
    color: #555 !important;
    border: 1px solid #d5d5d5;
}

.back-btn:hover {
    background: #f5f5f5;
    color: #333 !important;
}

.invoice-btn {
    background: #339999;
    color: #fff !important;
}

.invoice-btn:hover {
    background: #2d8787;
    color: #fff !important;
}


/* Mobile */

@media (max-width: 768px) {

    .order-details-wrapper {
        margin-top: 30px;
    }

    .order-page-title {
        font-size: 26px;
    }

    .order-info-card {
        padding: 20px;
    }

    .order-info-row {
        gap: 20px;
    }

    .order-products-card {
        overflow-x: auto;
    }

    .order-table {
        min-width: 800px;
    }

    .order-bottom-actions {
        flex-wrap: wrap;
    }

}

</style>








