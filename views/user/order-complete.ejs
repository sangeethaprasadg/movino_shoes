    <!-- MOVINO ORDER COMPLETE CUSTOM CSS -->

    <style>

        /* =========================================
           MOVINO THEME
        ========================================= */

        :root {
            --movino-color: #339999;
            --movino-dark: #2d8787;
            --movino-light: #e8f8f5;
            --movino-text: #222222;
            --movino-muted: #777777;
        }


        /* =========================================
           ORDER SUCCESS SECTION
        ========================================= */

        .movino-success-section {

            padding: 55px 15px 80px;

        }


        .movino-success-card {

            max-width: 760px;

            margin: 0 auto;

            background: #ffffff;

            border-radius: 18px;

            padding: 55px 50px;

            text-align: center;

            border: 1px solid #eeeeee;

            box-shadow:
                0 12px 35px rgba(0, 0, 0, 0.07);

        }


        /* =========================================
           SUCCESS ICON
        ========================================= */

        .movino-success-icon {

            width: 88px;

            height: 88px;

            margin: 0 auto 25px;

            border-radius: 50%;

            background: var(--movino-light);

            color: var(--movino-color);

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 42px;

        }


        .movino-success-icon i {

            line-height: 1;

        }


        /* =========================================
           TITLE
        ========================================= */

        .movino-success-card h2 {

            font-family: 'Rokkitt', serif;

            font-size: 34px;

            font-weight: 500;

            color: var(--movino-text);

            margin-bottom: 12px;

        }


        /* =========================================
           DESCRIPTION
        ========================================= */

        .movino-success-message {

            max-width: 560px;

            margin: 0 auto 28px;

            color: var(--movino-muted);

            font-family: 'Montserrat', sans-serif;

            font-size: 14px;

            line-height: 1.8;

        }


        /* =========================================
           ORDER ID
        ========================================= */

        .movino-order-id {

            display: inline-block;

            min-width: 250px;

            background: #f7fbfb;

            border: 1px solid #dceeee;

            border-radius: 10px;

            padding: 15px 25px;

            margin-bottom: 32px;

        }


        .movino-order-id-label {

            display: block;

            font-family: 'Montserrat', sans-serif;

            font-size: 11px;

            font-weight: 600;

            color: #999999;

            text-transform: uppercase;

            letter-spacing: 1px;

            margin-bottom: 6px;

        }


        .movino-order-id-value {

            display: block;

            font-family: 'Montserrat', sans-serif;

            font-size: 17px;

            font-weight: 600;

            color: var(--movino-color);

        }


        /* =========================================
           BUTTON AREA
        ========================================= */

        .movino-success-actions {

            display: flex;

            justify-content: center;

            align-items: center;

            gap: 12px;

            flex-wrap: wrap;

        }


        /* =========================================
           PRIMARY BUTTON
        ========================================= */

        .movino-btn-primary {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            min-width: 185px;

            padding: 13px 25px;

            background: var(--movino-color);

            color: #ffffff !important;

            border: 1px solid var(--movino-color);

            border-radius: 6px;

            font-family: 'Montserrat', sans-serif;

            font-size: 13px;

            font-weight: 600;

            text-decoration: none !important;

            transition: all 0.25s ease;

        }


        .movino-btn-primary:hover {

            background: var(--movino-dark);

            border-color: var(--movino-dark);

            color: #ffffff !important;

            transform: translateY(-1px);

        }


        /* =========================================
           SECONDARY BUTTON
        ========================================= */

        .movino-btn-outline {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            min-width: 185px;

            padding: 13px 25px;

            background: #ffffff;

            color: var(--movino-color) !important;

            border: 1px solid var(--movino-color);

            border-radius: 6px;

            font-family: 'Montserrat', sans-serif;

            font-size: 13px;

            font-weight: 600;

            text-decoration: none !important;

            transition: all 0.25s ease;

        }


        .movino-btn-outline:hover {

            background: var(--movino-color);

            color: #ffffff !important;

            transform: translateY(-1px);

        }


        /* =========================================
           BOTTOM MESSAGE
        ========================================= */

        .movino-success-note {

            margin-top: 32px;

            margin-bottom: 0;

            color: #999999;

            font-family: 'Montserrat', sans-serif;

            font-size: 12px;

        }


        .movino-success-note strong {

            color: var(--movino-color);

            font-weight: 600;

        }


        /* =========================================
           RESPONSIVE
        ========================================= */

        @media (max-width: 767px) {

            .movino-success-section {

                padding: 35px 15px 60px;

            }


            .movino-success-card {

                padding: 40px 20px;

            }


            .movino-success-card h2 {

                font-size: 28px;

            }


            .movino-success-message {

                font-size: 13px;

            }


            .movino-success-actions {

                flex-direction: column;

            }


            .movino-btn-primary,
            .movino-btn-outline {

                width: 100%;

                max-width: 260px;

            }

        }

    </style>

</head>


