                            </li>

                        <% } %>

                    </ul>

                </div>

            </div>

        </div>

    </div>


    <!-- SALE BAR -->

    <div class="sale">

        <div class="container">

            <div class="row">

                <div class="col-sm-8 offset-sm-2 text-center">

                    <div class="row">

                        <div class="owl-carousel2">

                            <div class="item">

                                <div class="col">

                                    <h3>
                                        <a href="#">
                                            25% off (Almost) Everything!
                                            Use Code: Summer Sale
                                        </a>
                                    </h3>

                                </div>

                            </div>


                            <div class="item">

                                <div class="col">

                                    <h3>
                                        <a href="#">
                                            Our biggest sale yet
                                            50% off all summer shoes
                                        </a>
                                    </h3>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</nav>


<!-- =========================================================
     BREADCRUMB
========================================================= -->

<div class="breadcrumbs">

    <div class="container">

        <div class="row">

            <div class="col">

                <p class="bread">

                    <span>
                        <a href="/">
                            Home
                        </a>
                    </span>

                    /

                    <span>
                        <a href="/cart">
                            Shopping Cart
                        </a>
                    </span>

                    /

                    <span>
                        Checkout
                    </span>

                </p>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     CHECKOUT PAGE
========================================================= -->

<div class="colorlib-product checkout-page">

    <div class="container">


        <!-- =================================================
             CHECKOUT STEPS
        ================================================== -->

        <div class="row row-pb-lg">

            <div class="col-sm-10 offset-md-1">

                <div class="process-wrap">

                    <div class="process text-center active">

                        <p>
                            <span>01</span>
                        </p>

                        <h3>
                            Shopping Cart
                        </h3>

                    </div>


                    <div class="process text-center active">

                        <p>
                            <span>02</span>
                        </p>

                        <h3>
                            Checkout
                        </h3>

                    </div>


                    <div class="process text-center">

                        <p>
                            <span>03</span>
                        </p>

                        <h3>
                            Order Complete
                        </h3>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             MAIN CHECKOUT ROW
        ================================================== -->

        <div class="row checkout-layout">


            <!-- =================================================
                 LEFT COLUMN
            ================================================== -->

            <div class="col-lg-8">


                <!-- DELIVERY ADDRESS CARD -->

                <div class="checkout-card">


                    <button
                        type="button"
                        class="btn btn-movino mb-4"
                        onclick="openAddAddressModal()">

                        + Add New Address

                    </button>


                    <h2>
                        Select Delivery Address
                    </h2>


                    <%

                        const defaultAddress =
                            otherAddresses.find(addr => addr.isDefault);

                        const otherNonDefault =
                            otherAddresses.filter(addr => !addr.isDefault);

                    %>


                    <!-- =================================================
                         DEFAULT ADDRESS
                    ================================================== -->

                    <% if (defaultAddress) { %>

                        <div class="address-section">

                            <h4>
                                DEFAULT ADDRESS
                            </h4>


                            <div
                                class="address-box default"
                                id="addressBox-default">


                                <label>

                                    <input
                                        type="radio"
                                        name="selectedAddress"
                                        value="<%= defaultAddress._id %>"
                                        onchange="handleAddressSelect('default')"
                                        checked
                                    >


                                    <strong>
                                        <%= defaultAddress.fullName %>
                                    </strong>


                                    <span class="tag">
                                        DEFAULT
                                    </span>

                                </label>


                                <p>

                                    <%= defaultAddress.addressLine %>,
                                    <%= defaultAddress.city %>,
                                    <%= defaultAddress.state %>
                                    -
                                    <%= defaultAddress.pincode %>

                                </p>


                                <p>

                                    Mobile:
                                    <%= defaultAddress.phone %>

                                </p>


                                <div
                                    class="address-actions"
                                    id="actions-default">


                                    <button
                                        type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        data-address='<%- JSON.stringify(defaultAddress) %>'
                                        onclick="handleEditClick(this)">

                                        Edit

                                    </button>


                                    <form
                                        action="/delete-address/<%= defaultAddress._id %>"
                                        method="POST"
                                        id="deleteForm-<%= defaultAddress._id %>"
                                        style="display:inline;">

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="confirmDelete('<%= defaultAddress._id %>')">

                                            Remove

                                        </button>

                                    </form>


                                </div>


                            </div>

                        </div>

                    <% } %>


                    <!-- =================================================
                         OTHER ADDRESSES
                    ================================================== -->

                    <% if (otherNonDefault.length > 0) { %>

                        <div class="address-section">

                            <h4>
                                OTHER ADDRESSES
                            </h4>


                            <% otherNonDefault.forEach((address, index) => { %>


                                <div
                                    class="address-box"
                                    id="addressBox-<%= index %>">


                                    <label>

                                        <input
                                            type="radio"
                                            name="selectedAddress"
                                            value="<%= address._id %>"
                                            onchange="handleAddressSelect('<%= index %>')"
                                        >


                                        <strong>
                                            <%= address.fullName %>
                                        </strong>

                                    </label>


                                    <p>

                                        <%= address.addressLine %>,
                                        <%= address.city %>,
                                        <%= address.state %>
                                        -
                                        <%= address.pincode %>

                                    </p>


                                    <p>

                                        Mobile:
                                        <%= address.phone %>

                                    </p>


                                    <div
                                        class="address-actions"
                                        id="actions-<%= index %>"
                                        style="display:none;">


                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-address='<%- JSON.stringify(address) %>'
                                            onclick="handleEditClick(this)">

                                            Edit

                                        </button>


                                        <form
                                            action="/delete-address/<%= address._id %>"
                                            method="POST"
                                            id="deleteForm-<%= address._id %>"
                                            style="display:inline;">

                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="confirmDelete('<%= address._id %>')">

                                                Remove

                                            </button>

                                        </form>


                                    </div>


                                </div>


                            <% }); %>

                        </div>

                    <% } %>


                </div>


                <!-- =================================================
                     PAYMENT INFORMATION
                ================================================== -->

                <div class="checkout-card">

                    <h2>
                        Payment Information
                    </h2>


                    <div class="payment-option">

                        <strong>
                            Cash on Delivery
                        </strong>

                        <p class="mb-0 mt-1 text-muted">

                            Pay when your order is delivered.

                        </p>

                    </div>

                </div>


            </div>


            <!-- =================================================
                 RIGHT COLUMN
            ================================================== -->

            <div class="col-lg-4">


                <div class="order-summary-card">


                    <h3>
                        Order Summary
                    </h3>


                    <%

                        let subtotal = 0;

                        cartItems.forEach((item) => {

                            const itemTotal =
                                item.productId.price * item.quantity;

                            subtotal += itemTotal;

                    %>


                        <div class="checkout-product">


                            <div class="checkout-product-name">

                                <%= item.productId.name %>

                            </div>


                            <div class="checkout-product-details">

                                Quantity:
                                <%= item.quantity %>

                            </div>


                            <div class="checkout-product-details">

                                Item Total:
                                ₹<%= itemTotal %>

                            </div>


                        </div>


                    <% }); %>


                    <%

                        const discount = 50;

                        const tax =
                            Math.round(subtotal * 0.05);

                        const shipping = 20;

                        const finalAmount =
                            subtotal +
                            tax +
                            shipping -
                            discount;

                    %>


                    <!-- PRICE DETAILS -->

                    <div class="price-details">


                        <div class="price-row">

                            <span>
                                Subtotal
                            </span>

                            <span>
                                ₹<%= subtotal %>
                            </span>

                        </div>


                        <div class="price-row">

                            <span>
                                Tax (5%)
                            </span>

                            <span>
                                ₹<%= tax %>
                            </span>

                        </div>


                        <div class="price-row">

                            <span>
                                Shipping
                            </span>

                            <span>
                                ₹<%= shipping %>
                            </span>

                        </div>


                        <div class="price-row discount">

                            <span>
                                Discount
                            </span>

                            <span>
                                - ₹<%= discount %>
                            </span>

                        </div>


                        <div class="total-row">

                            <span>
                                Total
                            </span>

                            <span>
                                ₹<%= finalAmount %>
                            </span>

                        </div>


                    </div>


                    <!-- =================================================
                         PAYMENT METHOD
                    ================================================== -->

                    <div class="payment-section">


                        <h5>
                            Payment Method
                        </h5>


                        <div class="payment-option">

                            Cash on Delivery

                        </div>


                        <form
                            action="/place-order"
                            method="POST"
                            id="placeOrderForm">


                            <input
                                type="hidden"
                                name="paymentMethod"
                                value="cod"
                            >


                            <input
                                type="hidden"
                                name="addressId"
                                id="hiddenAddressId"
                            >


                            <button
                                type="submit"
                                class="place-order-btn">

                                PLACE ORDER

                            </button>


                        </form>


                    </div>


                </div>


            </div>


        </div>


    </div>

</div>


<!-- =========================================================
     ADDRESS MODAL
     
     IMPORTANT:
     This is OUTSIDE the checkout row.
========================================================= -->

<div
    class="modal fade"
    id="addressModal"
    tabindex="-1"
    role="dialog"
    aria-labelledby="addressModalLabel"
    aria-hidden="true">


    <div
        class="modal-dialog"
        role="document">


        <form
            method="POST"
            action="/save-address"
            id="addressForm">


            <input
                type="hidden"
                name="_id"
                id="addressId"
            >


            <div class="modal-content">


                <div class="modal-header">


                    <h5
                        class="modal-title"
                        id="addressModalLabel">

                        Add Address

                    </h5>


                    <button
                        type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Close">

                        <span aria-hidden="true">
                            &times;
                        </span>

                    </button>


                </div>


                <div class="modal-body">


                    <div class="form-group">

                        <label>
                            Full Name
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            name="fullName"
                            id="fullName"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Address Line
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            name="addressLine"
                            id="addressLine"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            City
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            name="city"
                            id="city"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            State
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            name="state"
                            id="state"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Pincode
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            name="pincode"
                            id="pincode"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Phone
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            name="phone"
                            id="phone"
                        >

                    </div>


                </div>


                <div class="modal-footer">


                    <button
                        type="submit"
                        class="btn btn-primary">

                        Save Address

                    </button>


                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">

                        Cancel

                    </button>


                </div>


            </div>


        </form>


    </div>

</div>


<!-- =========================================================
     FOOTER
========================================================= -->

<footer id="colorlib-footer" role="contentinfo">

