  <script>
	function handleAddressSelect(selectedId) {
		document.querySelectorAll('.address-actions').forEach(div => {
			div.style.display = 'none';
		});
		const selectedDiv = document.getElementById(`actions-${selectedId}`);
		if (selectedDiv) {
			selectedDiv.style.display = 'block';
		}
	}
	
	window.addEventListener('DOMContentLoaded', () => {
		const radios = document.querySelectorAll('input[name="selectedAddress"]');
	
		radios.forEach(radio => {
			if (radio.checked) {
				const match = radio.getAttribute('onchange').match(/handleAddressSelect\('(.+?)'\)/);
				if (match) {
					handleAddressSelect(match[1]);
				}
			}
			radio.addEventListener('change', () => {
				const match = radio.getAttribute('onchange').match(/handleAddressSelect\('(.+?)'\)/);
				if (match) {
					handleAddressSelect(match[1]);
				}
			});
		});
	
		// Set initial addressId on page load
		const selected = document.querySelector('input[name="selectedAddress"]:checked');
		if (selected) {
			document.getElementById('hiddenAddressId').value = selected.value;
		}
	});
	
	function openAddAddressModal() {
		document.getElementById('addressModalLabel').textContent = 'Add Address';
		document.getElementById('addressForm').reset();
		document.getElementById('addressId').value = '';
		clearErrors();
		$('#addressModal').modal('show');
	}
	
	function handleEditClick(button) {
		try {
			const address = JSON.parse(button.getAttribute('data-address'));
			openEditAddressModal(address);
		} catch (e) {
			console.error("Invalid address data", e);
		}
	}
	
	function openEditAddressModal(address) {
		document.getElementById('addressModalLabel').textContent = 'Edit Address';
		document.getElementById('addressId').value = address._id;
		document.getElementById('fullName').value = address.fullName;
		document.getElementById('addressLine').value = address.addressLine;
		document.getElementById('city').value = address.city;
		document.getElementById('state').value = address.state;
		document.getElementById('pincode').value = address.pincode;
		document.getElementById('phone').value = address.phone;
		clearErrors();
		$('#addressModal').modal('show');
	}
	
	document.querySelectorAll('input[name="selectedAddress"]').forEach(radio => {
		radio.addEventListener('change', () => {
			document.getElementById('hiddenAddressId').value = radio.value;
		});
	});
	
	/* -------------------------------
	   Inline Address Form Validation
	--------------------------------*/
	function showError(inputId, message) {
		const input = document.getElementById(inputId);
		let errorEl = input.nextElementSibling;
		if (!errorEl || !errorEl.classList.contains('error-message')) {
			errorEl = document.createElement('div');
			errorEl.classList.add('error-message');
			errorEl.style.color = 'red';
			errorEl.style.fontSize = '0.9em';
			input.insertAdjacentElement('afterend', errorEl);
		}
		errorEl.textContent = message;
	}
	
	function clearErrors() {
		document.querySelectorAll('.error-message').forEach(el => el.remove());
	}
	
	document.getElementById('addressForm').addEventListener('submit', function (e) {
		clearErrors();
		let isValid = true;
	
		const fullName = document.getElementById('fullName').value.trim();
		const addressLine = document.getElementById('addressLine').value.trim();
		const city = document.getElementById('city').value.trim();
		const state = document.getElementById('state').value.trim();
		const pincode = document.getElementById('pincode').value.trim();
		const phone = document.getElementById('phone').value.trim();
	
		if (fullName.length < 3) {
			isValid = false;
			showError('fullName', "Full name must be at least 3 characters.");
		}
		if (addressLine.length < 5) {
			isValid = false;
			showError('addressLine', "Address line must be at least 5 characters.");
		}
		if (!/^[A-Za-z\s]+$/.test(city)) {
			isValid = false;
			showError('city', "City should contain only letters.");
		}
		if (!/^[A-Za-z\s]+$/.test(state)) {
			isValid = false;
			showError('state', "State should contain only letters.");
		}
		if (!/^\d{6}$/.test(pincode)) {
			isValid = false;
			showError('pincode', "Pincode must be exactly 6 digits.");
		}
		if (!/^[6-9]\d{9}$/.test(phone)) {
			isValid = false;
			showError('phone', "Phone must be a valid 10-digit number starting with 6-9.");
		}
	
		if (!isValid) {
			e.preventDefault();
		}
	});
	</script>
	


	<script>
		function confirmDelete(addressId) {
		  Swal.fire({
			title: 'Are you sure?',
			text: "You won't be able to revert this action!",
			icon: 'warning',
			showCancelButton: true,
			confirmButtonColor: '#d33',
			cancelButtonColor: '#6c757d',
			confirmButtonText: 'Yes, delete it'
		  }).then((result) => {
			if (result.isConfirmed) {
			  document.getElementById('deleteForm-' + addressId).submit();
			}
		  });
		}


		
		// </script>
		
		
		  


