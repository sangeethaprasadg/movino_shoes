							   </button>
					   
							   <form action="/delete-address/<%= defaultAddress._id %>" method="POST" style="display:inline;">
								 <button type="submit" class="btn btn-sm btn-outline-danger"  onclick="confirmDelete('<%= defaultAddress._id %>')">
								   Remove
								 </button>
							   </form>
							 </div>
						   </div>
						 <!-- </div> -->
					   <% } %>
					   
					   <!-- OTHER ADDRESSES -->
					   <% if (otherNonDefault.length > 0) { %>
