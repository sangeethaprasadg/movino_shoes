<!DOCTYPE HTML>
<html>

<head>

    <title>CHECKOUT</title>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600,700"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css?family=Rokkitt:100,300,400,700"
          rel="stylesheet">

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Existing CSS -->
    <link rel="stylesheet" href="css/animate.css">
    <link rel="stylesheet" href="css/icomoon.css">
    <link rel="stylesheet" href="css/ionicons.min.css">
    <link rel="stylesheet" href="css/bootstrap.min.css">
    <link rel="stylesheet" href="css/magnific-popup.css">
    <link rel="stylesheet" href="css/flexslider.css">
    <link rel="stylesheet" href="css/owl.carousel.min.css">
    <link rel="stylesheet" href="css/owl.theme.default.min.css">
    <link rel="stylesheet" href="css/bootstrap-datepicker.css">
    <link rel="stylesheet" href="fonts/flaticon/font/flaticon.css">
    <link rel="stylesheet" href="css/style.css">


<style>

/* =========================================================
   MOVINO CHECKOUT STYLING
========================================================= */

:root {
    --movino: #339999;
    --movino-dark: #2d8787;
    --text-dark: #222;
    --text-muted: #777;
    --border: #e8e8e8;
    --background: #fafafa;
}


/* PAGE */

.checkout-page {
    background: #fafafa;
    padding-bottom: 70px;
}


/* =========================================================
   CHECKOUT LAYOUT
========================================================= */

.checkout-layout {
    align-items: flex-start;
}


/* =========================================================
   COMMON CARD
========================================================= */

.checkout-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 28px;
    margin-bottom: 25px;
    border: 1px solid #eeeeee;
    box-shadow: 0 8px 25px rgba(0,0,0,0.05);
}

.checkout-card h2 {
    font-size: 24px;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 25px;
}

.checkout-card h4 {
    font-size: 16px;
    font-weight: 600;
    color: #333;
}


/* =========================================================
   ADD ADDRESS BUTTON
========================================================= */

.btn-movino {
    background: var(--movino);
    color: #fff !important;
    border: none;
    border-radius: 25px;
    padding: 10px 22px;
    font-size: 14px;
    font-weight: 500;
    transition: 0.25s;
}

.btn-movino:hover {
    background: var(--movino-dark);
    color: #fff !important;
    transform: translateY(-1px);
}


/* =========================================================
   ADDRESS SECTION
========================================================= */

.address-section {
    margin-top: 25px;
}

.address-section h4 {
    font-size: 13px;
    letter-spacing: 0.8px;
    color: #777;
    margin-bottom: 12px;
    font-weight: 600;
}


/* ADDRESS CARD */

.address-box {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 13px;
    padding: 20px;
    margin-bottom: 15px;
    transition: all 0.25s ease;
}

.address-box:hover {
    border-color: var(--movino);
    box-shadow: 0 5px 18px rgba(51,153,153,0.08);
}


/* DEFAULT ADDRESS */

.address-box.default {
    border: 1.5px solid var(--movino);
    background: #f8ffff;
}


/* RADIO */

.address-box input[type="radio"] {
    accent-color: var(--movino);
    margin-right: 8px;
}


/* NAME */

.address-box label {
    cursor: pointer;
    font-size: 15px;
    color: #222;
}


/* ADDRESS TEXT */

.address-box p {
    margin: 8px 0 0 25px;
    color: #777;
    font-size: 14px;
    line-height: 1.6;
}


/* DEFAULT TAG */

.tag {
    background: var(--movino);
    color: #fff;
    padding: 4px 9px;
    border-radius: 12px;
    font-size: 9px;
    font-weight: 600;
    margin-left: 8px;
}


/* ADDRESS ACTIONS */

.address-actions {
    margin-left: 25px;
    margin-top: 15px;
}

.address-actions button {
    margin-right: 7px;
}


/* =========================================================
   ORDER SUMMARY
========================================================= */

.order-summary-card {
    background: #fff;
    border-radius: 16px;
    padding: 28px;
    border: 1px solid #eeeeee;
    box-shadow: 0 8px 25px rgba(0,0,0,0.06);

    position: sticky;
    top: 25px;
}

.order-summary-card h3 {
    font-size: 21px;
    font-weight: 600;
    color: #222;
    margin-bottom: 20px;
}


/* =========================================================
   PRODUCT SUMMARY
========================================================= */

.checkout-product {
    padding: 15px 0;
    border-bottom: 1px solid #eeeeee;
}

.checkout-product:first-of-type {
    padding-top: 5px;
}

.checkout-product:last-of-type {
    border-bottom: none;
}


.checkout-product-name {
    font-size: 15px;
    font-weight: 600;
    color: #333;
    margin-bottom: 5px;
}


.checkout-product-details {
    font-size: 13px;
    color: #777;
    line-height: 1.6;
}


/* =========================================================
   PRICE DETAILS
========================================================= */

.price-details {
    margin-top: 15px;
    padding-top: 10px;
    border-top: 1px solid #eeeeee;
}


.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin: 12px 0;

    color: #666;
    font-size: 14px;
}


.price-row.discount span:last-child {
    color: #16a34a;
}


/* TOTAL */

.total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding-top: 17px;
    margin-top: 17px;

    border-top: 1px solid #dddddd;

    font-size: 18px;
    font-weight: 700;

    color: #222;
}


/* =========================================================
   PAYMENT
========================================================= */

.payment-section {
    margin-top: 28px;
    padding-top: 25px;
    border-top: 1px solid #eeeeee;
}

.payment-section h5 {
    font-size: 16px;
    font-weight: 600;
    color: #333;
    margin-bottom: 15px;
}


.payment-option {
    border: 1px solid #e3e3e3;
    border-radius: 10px;
    padding: 13px 15px;

    color: #333;
    font-size: 14px;

    background: #fafafa;
}


/* =========================================================
   PLACE ORDER
========================================================= */

.place-order-btn {
    width: 100%;

    background: var(--movino);
    color: white;

    border: none;
    border-radius: 9px;

    padding: 14px;

    font-size: 15px;
    font-weight: 600;

    margin-top: 18px;

    transition: 0.25s;
}

.place-order-btn:hover {
    background: var(--movino-dark);
    color: white;
    transform: translateY(-1px);
}


/* =========================================================
   MODAL
========================================================= */

#addressModal .modal-content {
    border: none;
    border-radius: 15px;
    overflow: hidden;
}


#addressModal .modal-header {
    background: var(--movino);
    color: white;
    border: none;
}


#addressModal .modal-title {
    font-weight: 600;
}


#addressModal .modal-header .close {
    color: white;
    opacity: 1;
}


#addressModal .form-group {
    margin-bottom: 15px;
}


#addressModal label {
    font-size: 13px;
    font-weight: 600;
    color: #444;
}


#addressModal .form-control {
    border-radius: 8px;
    border: 1px solid #ddd;
    padding: 10px 12px;
}


#addressModal .form-control:focus {
    border-color: var(--movino);
    box-shadow: 0 0 0 0.15rem rgba(51,153,153,0.15);
}


#addressModal .modal-footer .btn-primary {
    background: var(--movino);
    border-color: var(--movino);
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 991px) {

    .order-summary-card {
        position: static;
        margin-top: 10px;
    }

}


@media (max-width: 575px) {

    .checkout-card,
    .order-summary-card {
        padding: 20px;
        border-radius: 12px;
    }

    .checkout-card h2 {
        font-size: 21px;
    }

    .address-box {
        padding: 16px;
    }

    .address-box p {
        margin-left: 0;
    }

    .address-actions {
        margin-left: 0;
    }

}

</style>

</head>


<body>

<div class="colorlib-loader"></div>

<div id="page">


<!-- =========================================================
     NAVBAR
========================================================= -->

