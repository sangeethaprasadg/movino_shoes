                    </div>

                </div>

            </div>


            <div class="row">

                <div class="col-sm-12 text-left menu-1">

                    <ul>

                        <li>
                            <a href="/">Home</a>
                        </li>


                        <li class="has-dropdown active">

                            <ul class="dropdown">

                                <li>
                                    <a href="product-detail.html">
                                        Product Detail
                                    </a>
                                </li>

                                <li>
                                    <a href="cart.html">
