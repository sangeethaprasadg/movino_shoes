<%- include("../../views/partials/admin/header") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">

      <!-- Search & Add Product -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <form class="d-flex flex-grow-1 me-2" action="/admin/products" method="GET">
          <input
            type="text"
            name="search"
            class="form-control me-2"
            placeholder="Search by product..."
            value="<%= searchQuery || '' %>"
          >
          <button type="submit" class="btn btn-primary me-2">Search</button>
          <a href="/admin/products" class="btn btn-secondary">Reset</a>
        </form>

        <div class="d-flex gap-2">
          <a href="/admin/products/add" class="btn btn-success">
            Add Product
          </a>
        </div>
      </div>

      <!-- Product Table -->
      <div class="table-responsive">
        <table class="table table-bordered table-striped text-center align-middle">

          <thead class="table-dark">
            <tr>
              <th>Sl. No</th>
              <th>Image</th>
              <th>Product Name</th>
              <th>Category</th>
              <th>Subcategory</th>
              <th>Price (₹)</th>
              <th>Stock</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>

            <% if(products.length === 0){ %>

              <tr>
                <td colspan="9">No products added.</td>
              </tr>

            <% } else { %>

              <% products.forEach((p,index)=>{ %>

                <tr>

                  <!-- Serial Number -->
                  <td>
                    <%= index + 1 + ((currentPage - 1) * limit) %>
                  </td>

                  <!-- Product Images -->
                  <td>
                    <% p.images.forEach(img=>{ %>
                      <img
                        src="/uploads/products/<%= img %>"
                        width="50"
                        height="40"
                        class="m-1 rounded shadow-sm"
                      >
                    <% }) %>
                  </td>

                  <td><%= p.name %></td>

                  <td>
                    <%= p.category ? p.category.categoryName : "" %>
                  </td>

                  <td><%= p.subcategory %></td>

                  <td>₹<%= p.price %></td>

                  <td><%= p.stock %></td>

                  <!-- Stock Status -->
                  <td>

                    <% if(p.stock === 0){ %>

                      <span class="badge bg-danger">
                        Out of Stock
                      </span>

                    <% } else if(p.stock < 5){ %>

                      <span class="badge bg-warning text-dark">
                        Low Stock
                      </span>

                    <% } else { %>

                      <span class="badge bg-success">
                        In Stock
                      </span>

                    <% } %>

                  </td>

                  <!-- Action Buttons -->
                  <td>

                    <!-- Edit -->
                    <a
                      href="/admin/products/edit/<%= p._id %>"
                      class="btn btn-warning btn-sm"
                    >
                      ✏️ Edit
                    </a>

                  <% if(p.isListed){ %>

                      <!-- Unlist Product -->

                      <a
                        href="#"
                        class="btn btn-danger btn-sm"
                        onclick="confirmUnlist('/admin/products/unlist/<%= p._id %>'); return false;"
                      >
                        🚫 Unlist
                      </a>

                    <% } else { %>

                      <!-- List Product -->

                      <a
                        href="#"
                        class="btn btn-success btn-sm"
                        onclick="confirmList('/admin/products/list/<%= p._id %>'); return false;"
                      >
                        ✅ List
                      </a>

                    <% } %>

                    <!-- View Variants -->

                    <a
                      href="/admin/products/<%= p._id %>/variants"
                      class="btn btn-info btn-sm"
                    >
                      View Variants
                    </a>

                  </td>

                </tr>

              <% }) %>

            <% } %>

          </tbody>

        </table>

      </div>

      <!-- Pagination -->
      <nav>

        <ul class="pagination justify-content-center mt-4">

          <% for(let i=1;i<=totalPages;i++){ %>

            <li class="page-item <%= currentPage===i ? 'active' : '' %>">

              <a
                class="page-link"
                href="?page=<%= i %>&search=<%= searchQuery %>"
              >
                <%= i %>
              </a>

            </li>

          <% } %>

        </ul>

      </nav>

    </div>
  </div>
</div>

<!-- SweetAlert Functions -->

<script>

  // Confirm before Unlisting

  function confirmUnlist(url){

    Swal.fire({

      title:"Unlist Product?",

      text:"This product will be hidden from customers.",

      icon:"warning",

      showCancelButton:true,

      confirmButtonColor:"#d33",

      cancelButtonColor:"#3085d6",

      confirmButtonText:"Yes, Unlist",

      cancelButtonText:"Cancel"

    }).then((result)=>{

      if(result.isConfirmed){

        window.location.href=url;

      }

    });

  }

  // Confirm before Listing

  function confirmList(url){

    Swal.fire({

      title:"List Product?",

      text:"This product will be visible to customers again.",

      icon:"success",

      showCancelButton:true,

      confirmButtonColor:"#198754",

      cancelButtonColor:"#3085d6",

      confirmButtonText:"Yes, List",

      cancelButtonText:"Cancel"

    }).then((result)=>{

      if(result.isConfirmed){

        window.location.href=url;

      }

    });

  }

</script>

<%- include("../../views/partials/admin/footer") %>