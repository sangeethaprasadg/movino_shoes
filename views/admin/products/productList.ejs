<%- include("../../views/partials/admin/header") %>

<style>
/* action buttons */


.action-buttons{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:10px;
}

.action-btn{
    width:38px;
    height:38px;
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    font-size:16px;
    transition:0.25s ease;
}

.edit-btn{
    background:#fff8e6;
    color:#f59e0b;
}

.variant-btn{
    background:#e6f7f7;
    color:#339999;
}

.unlist-btn{
    background:#ffeaea;
    color:#dc3545;
}

.list-btn{
    background:#eafaf1;
    color:#198754;
}

.action-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 4px 10px rgba(0,0,0,.15);
}

.disabled-btn{
    background:#f3f4f6;
    color:#9ca3af;
    cursor:pointer;
}

.disabled-btn:hover{
    background:#e5e7eb;
    color:#6b7280;
}


.table td{
    vertical-align:middle;
    padding:18px 12px;
}




/* product image */

.product-img{

    width:72px;
    height:72px;

    border-radius:12px;

    border:1px solid #ececec;

    object-fit:cover;

    padding:5px;

    background:white;

}

thead{
    background:#339999;
}

thead th{
    color:white;
}
.product-table tbody tr{

    background:white;

}

.product-table tbody tr:hover{

    background:#fafafa;

}




tbody tr:hover{
    background:#f8f9fa;
}



/*======================
      Product Table
=======================*/

.product-table{
    background:#fff;
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 8px 20px rgba(0,0,0,.06);
    border-collapse:separate;
    border-spacing:0;
}

/* Header */

.product-table thead{
    
      background:#f4f5f7;
}

.product-table thead th{
    background:#f4f5f7;
    color:#2d3748;
    font-size:15px;
    font-weight:600;
    padding:18px;
    border-bottom:1px solid #e5e7eb;
    border-right:1px solid #e5e7eb;
    white-space:nowrap;
}

.product-table thead th:last-child{
    border-right:none;
}




/* Body */

.product-table tbody td{
    padding:18px 14px;
    vertical-align:middle;
    border-top:1px solid #f1f3f5;
    color:#444;
    font-size:15px;
}

/* Hover */

.product-table tbody tr{
    transition:.25s;
}

.product-table tbody tr:hover{
    background:#fcfcfc;
}

/* Vertical borders */

.product-table td,
.product-table th{
   border-right:1px solid #f5f5f5;
}

.product-table td:last-child,
.product-table th:last-child{
    border-right:none;
}

.stock-badge{

    display:inline-block;

    padding:5px 14px;

    background:#e8f8ef;

    color:#2f9e44;

    border-radius:20px;

    font-size:13px;

    font-weight:600;
}



</style>


<div class="container-fluid py-4 px-4">
    <div class="row">
        <div class="col-12">


<div class="mb-4">

    <h2 class="fw-bold mb-1">
        Product Management
    </h2>

    <p class="text-muted mb-0">
        Manage and organize your store products
    </p>

</div>




  
<!-- Search & Add Product -->



    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

    <form
        action="/admin/products"
        method="GET"
        class="d-flex align-items-center gap-2 flex-grow-1">

        <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search by product..."
            value="<%= searchQuery || '' %>"
            style="max-width:520px;">

        <button
            class="btn text-white px-4"
            style="background:#495057;">
            Search
        </button>

        <a
            href="/admin/products"
            class="btn btn-outline-secondary">
            Reset
        </a>

    </form>

    <a
        href="/admin/products/add"
        class="btn text-white px-4"
        style="background:#339999;">
        Add Product
    </a>

</div>









      <!-- Product Table -->
  <div class="table-responsive rounded-4 shadow-sm overflow-hidden">
       <table class="table product-table align-middle">

       <thead>
            <tr>
              <th>Sl. No</th>
              <th>Image</th>
              <th>Product Name</th>
              <th>Category</th>
              <th>Subcategory</th>
              <th>Price (₹)</th>
              <th>Stock</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>

            <% if(products.length === 0){ %>

              <tr>
                <td colspan="9">No products added.</td>
              </tr>

            <% } else { %>

              <% products.forEach((p,index)=>{ %>

                <tr>

                  <!-- Serial Number -->
                  <td>
                    <%= index + 1 + ((currentPage - 1) * limit) %>
                  </td>

                  <!-- Product Images -->
                  <td>
                  <img
                  src="/uploads/products/<%= p.images[0] %>"
                  class="product-img">
                  </td>

                  <td><%= p.name %></td>

                  <td>
                    <%= p.category ? p.category.categoryName : "" %>
                  </td>

                  <td><%= p.subcategory %></td>

                  <td>₹<%= p.price %></td>

                  <td><%= p.stock %></td>

                  <!-- Stock Status -->
                  <td>

                    <% if(p.stock === 0){ %>

                      <span class="badge bg-danger">
                        Out of Stock
                      </span>

                    <% } else if(p.stock < 5){ %>

                      <span class="badge bg-warning text-dark">
                        Low Stock
                      </span>

                    <% } else { %>

                    <span class="stock-badge">
    
                      In Stock

                    </span>

                    <% } %>

                  </td>

                  <!-- Action Buttons -->
                  
                <td>

<div class="action-buttons">

    <!-- Edit -->
    <a href="/admin/products/edit/<%= p._id %>"
       class="action-btn edit-btn"
       title="Edit">
        <i class="bi bi-pencil-square"></i>
    </a>

    <!-- Variants -->
   
<a href="#"
   class="action-btn variant-btn"
   title="Variants"
   onclick="showVariants('<%= p._id %>'); return false;">

    <i class="bi bi-grid-3x3-gap-fill"></i>

</a>






    <% if(p.isListed){ %>

        <!-- Unlist -->
        <a href="#"
           class="action-btn unlist-btn"
           title="Unlist"
           onclick="confirmUnlist('/admin/products/unlist/<%= p._id %>'); return false;">
            <i class="bi bi-eye-slash-fill"></i>
        </a>

   <% } else { %>

   <% if (p.category && !p.category.isListed) { %>

    <a href="#"
       class="action-btn disabled-btn"
       title="Category Unlisted"
       onclick="categoryWarning(); return false;">
        <i class="bi bi-lock-fill"></i>
    </a>

<% } else { %>

    <a href="#"
       class="action-btn list-btn"
       title="List Product"
       onclick="confirmList('/admin/products/list/<%= p._id %>'); return false;">
        <i class="bi bi-eye-fill"></i>
    </a>

<% } %>

<% } %>

</div>

</td>











                </tr>

              <% }) %>

            <% } %>

          </tbody>

        </table>

      </div>

      <!-- Pagination -->
      <nav>

        <ul class="pagination justify-content-center mt-4">

          <% for(let i=1;i<=totalPages;i++){ %>

            <li class="page-item <%= currentPage===i ? 'active' : '' %>">

              <a
                class="page-link"
                href="?page=<%= i %>&search=<%= searchQuery %>"
              >
                <%= i %>
              </a>

            </li>

          <% } %>

        </ul>

      </nav>

    </div>
  </div>
</div>


<!-- Variant Modal -->
<div class="modal fade" id="variantModal" tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Product Variants
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <h6 id="productTitle"></h6>

                <table class="table">

                    <thead>

                        <tr>

                            <th>Size</th>

                            <th>Stock</th>

                        </tr>

                    </thead>

                    <tbody id="variantTable">

                    </tbody>

                </table>

                <div class="text-end">

                    <strong>

                        Total Stock :

                        <span id="totalStock"></span>

                    </strong>

                </div>

            </div>

        </div>

    </div>

</div>









<!-- SweetAlert Functions -->

<script>

  // Confirm before Unlisting

  function confirmUnlist(url){

    Swal.fire({

      title:"Unlist Product?",

      text:"This product will be hidden from customers.",

      icon:"warning",

      showCancelButton:true,

      confirmButtonColor:"#d33",

      cancelButtonColor:"#3085d6",

      confirmButtonText:"Yes, Unlist",

      cancelButtonText:"Cancel"

    }).then((result)=>{

      if(result.isConfirmed){

        window.location.href=url;

      }

    });

  }

  // Confirm before Listing

  function confirmList(url){

    Swal.fire({

      title:"List Product?",

      text:"This product will be visible to customers again.",

      icon:"success",

      showCancelButton:true,

      confirmButtonColor:"#198754",

      cancelButtonColor:"#3085d6",

      confirmButtonText:"Yes, List",

      cancelButtonText:"Cancel"

    }).then((result)=>{

      if(result.isConfirmed){

        window.location.href=url;

      }

    });

  }
  
function categoryWarning() {

    Swal.fire({

        icon: "warning",

        title: "Category Unlisted",

        text: "Please list the category before listing this product.",

        confirmButtonColor: "#3085d6"

    });

}


async function showVariants(productId) {

    try {

        const response = await fetch(`/admin/products/variants/${productId}`);

        const data = await response.json();

        if (!data.success) return;

        document.getElementById("productTitle").innerText =
            data.productName;

        document.getElementById("totalStock").innerText =
            data.totalStock;

        let html = "";

        data.variants.forEach(variant => {

            let badge = "";

            if (variant.stock === 0) {

                badge =
                `<span class="badge bg-danger">Out of Stock</span>`;

            } else if (variant.stock < 5) {

                badge =
                `<span class="badge bg-warning text-dark">${variant.stock}</span>`;

            } else {

                badge =
                `<span class="badge bg-success">${variant.stock}</span>`;

            }

            html += `
                <tr>
                    <td>${variant.size}</td>
                    <td>${badge}</td>
                </tr>
            `;

        });

        document.getElementById("variantTable").innerHTML = html;

        const modal = new bootstrap.Modal(
            document.getElementById("variantModal")
        );

        modal.show();

    } catch (err) {

        console.log(err);

    }

}






</script>

<%- include("../../views/partials/admin/footer") %>