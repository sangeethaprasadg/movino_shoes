<style>
  .error-message {
    color: red;
    font-size: 0.875rem;
    margin-top: 4px;
  }
</style>

<script>
  const imageInput = document.getElementById('imagesInput');
  const previewDiv = document.getElementById('newImagePreview');
  const form = document.getElementById('editProductForm');

  // Show previews of newly selected images
  imageInput.addEventListener('change', () => {
    previewDiv.innerHTML = '';
    const files = Array.from(imageInput.files);

    files.forEach(file => {
      const reader = new FileReader();
      reader.onload = function(e) {
        const img = document.createElement('img');
        img.src = e.target.result;
        img.classList.add('me-2', 'mb-2');
        img.style.height = '60px';
        img.style.width = '60px';
        img.style.objectFit = 'cover';
        img.style.border = '1px solid #ccc';
        img.style.borderRadius = '5px';
        previewDiv.appendChild(img);
      };
      reader.readAsDataURL(file);
    });
  });

  // Function to show error below field
  function showError(input, message) {
    let errorElement = input.parentElement.querySelector('.error-message');
    if (!errorElement) {
      errorElement = document.createElement('div');
      errorElement.classList.add('error-message');
      input.parentElement.appendChild(errorElement);
    }
    errorElement.textContent = message;
  }

  // Function to clear errors
  function clearErrors() {
    document.querySelectorAll('.error-message').forEach(el => el.remove());
  }

  // On form submit
  form.addEventListener('submit', function(e) {
    clearErrors();
    let valid = true;

    const name = form.name;
    const price = form.price;
   
    const description = form.description;
    const files = imageInput.files;

    if (name.value.trim() === '') {
      showError(name, 'Product name is required');
      valid = false;
    }
    if (price.value.trim() === '' || price.value <= 0) {
      showError(price, 'Enter a valid price');
      valid = false;
    }
    
const sizes = document.getElementsByName("size");
const stocks = document.getElementsByName("variantStock");

for (let i = 0; i < sizes.length; i++) {

  if (sizes[i].value.trim() === "") {
    showError(sizes[i], "Size is required");
    valid = false;
  }

  if (
    stocks[i].value.trim() === "" ||
    Number(stocks[i].value) < 0
  ) {
    showError(stocks[i], "Enter a valid stock");
    valid = false;
  }

}



    if (description.value.trim() === '') {
      showError(description, 'Description cannot be empty');
      valid = false;
    }

    if (files.length > 0 && files.length < 3) {
      showError(imageInput, 'Please upload at least 3 images to replace existing ones');
      valid = false;
    }

    if (!valid) {
      e.preventDefault();
    }
  });



const variantContainer = document.getElementById("variantContainer");
const addVariantBtn = document.getElementById("addVariant");

addVariantBtn.addEventListener("click", function () {

    const row = document.createElement("div");

    row.className = "row mb-2 variant-row";

    row.innerHTML = `
        <div class="col-md-5">
            <input
                type="text"
                name="size"
                class="form-control"
                placeholder="Enter Size">
        </div>

        <div class="col-md-5">
            <input
                type="number"
                name="variantStock"
                class="form-control"
                placeholder="Enter Stock">
        </div>

        <div class="col-md-2">
            <button
                type="button"
                class="btn btn-danger removeVariant">
                Remove
            </button>
        </div>
    `;

    variantContainer.appendChild(row);
});

variantContainer.addEventListener("click", function (e) {

    if (e.target.classList.contains("removeVariant")) {

        e.target.closest(".variant-row").remove();

    }

});












</script>



