<%- include("../../views/partials/admin/header") %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<main class="container py-5"> <!-- Increased padding -->

    <!-- Page Title + Add Category + Recovery Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Category Management</h2>
        <div>
           
            <a href="/admin/categories/add" class="btn btn-success">+ Add Category</a>
        </div>
    </div>

    <!-- Search & Reset -->
    <div class="d-flex mb-4">
        <input type="text" id="searchInput" class="form-control" placeholder="Search category or subcategory..."
               value="<%= search || '' %>">
        <button class="btn btn-primary ms-2" onclick="searchCategory()">Search</button>
        <button class="btn btn-secondary ms-2" onclick="clearSearch()">Reset</button>
    </div>

    <!-- Category Table -->
    <div class="table-responsive">
        <table class="table table-bordered text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>SL No</th>
                    <th>Image</th>
                    <th>Category</th>
                    <th>Subcategory</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (categories.length === 0) { %>
                    <tr>
                        <td colspan="6" class="text-muted">No categories found.</td>
                    </tr>
                <% } else { %>
                    <% categories.forEach((cat, index) => { %>
                        <tr>
                            <td><%= (currentPage - 1) * limit + index + 1 %></td>
                            <td>
                                <% if (cat.image) { %>
                                    <img src="/uploads/categories/<%= cat.image %>" alt="Category Image" width="60">
                                <% } else { %>
                                    <span class="text-muted">No image</span>
                                <% } %>
                            </td>
                            <td><%= cat.categoryName %></td>
                            <td><%= cat.subCategory %></td>
                           <td>
    <%= cat.isListed ? "Listed" : "Unlisted" %>
</td>
                            <td>
                                
                                 

                             <a href="/admin/categories/edit/<%= cat._id %>" class="btn btn-warning btn-sm mb-1">
    Edit
</a>
             <% const isListed = cat.isListed; %>

<button
    class="btn <%= isListed ? 'btn-danger' : 'btn-success' %> btn-sm mb-1"
    onclick="toggleCategoryListing('<%= cat._id %>', '<%= isListed %>')">
    <%= isListed ? "Unlist" : "List" %>
</button>                      
                                 
                                
                                  
                            </td>
                          

                            
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4">
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?search=<%= search %>&page=<%= i %>"><%= i %></a>
                    </li>
                <% } %>
            </ul>
        </nav>
    <% } %>

</main>

<%- include("../../views/partials/admin/footer") %>

<!-- JavaScript -->
<script>
    function searchCategory() {
        const query = document.getElementById("searchInput").value.trim();
        window.location.href = `/admin/categories?search=${query}`;
    }

    function clearSearch() {
        window.location.href = '/admin/categories';
    }

 
function toggleCategoryListing(id,isListed) {





      isListed = isListed === "true";

    const action = isListed ? "Unlist" : "List";
    Swal.fire({
     title: `Are you sure you want to ${action}?`,
text: `This category and its products will be ${action.toLowerCase()}ed.`,
confirmButtonText: `Yes, ${action} it!`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
      
        cancelButtonText: 'Cancel'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch(`/admin/categories/toggle-list/${id}`, {
                method: "POST"
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                     title: `${action}ed!`,
text: `Category ${action.toLowerCase()}ed successfully.`,
                      
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        location.reload();
                    });
                } else {
                    Swal.fire(
    "Failed!",
    "Unable to update category status.",
    "error"
);
                }
            });
        }
    });
}


</script>
